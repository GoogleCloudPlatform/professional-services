# ==============================================================================
# BigQuery Data Modeling Agent Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values with your GCP configuration.

# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Vertex AI Configuration (Set to true for Vertex AI, false if using GEMINI_API_KEY)
GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_API_KEY=your-gemini-api-key

# BigQuery Dataset & Project Configuration
BQ_DATA_PROJECT_ID=your-gcp-project-id
BQ_COMPUTE_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=your_dataset_id

# Agent Model Configuration
ROOT_AGENT_MODEL=gemini-2.5-flash

# Optional: Cloud Storage bucket for exported model artifacts
# MODEL_OUTPUT_GCS_FOLDER=your-artifacts-bucket

# Optional: Vertex AI Search Datastore ID for document store search
# VERTEX_DATASTORE_ID=your-datastore-id
