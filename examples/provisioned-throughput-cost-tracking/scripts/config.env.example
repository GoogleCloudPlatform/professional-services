# Copy to config.env and edit. All scripts read this file.
# cp scripts/config.env.example scripts/config.env

# The shared project that holds (or will hold) the Provisioned Throughput order.
PROJECT_ID="your-shared-project"
# Endpoint location and model used by the sample requests.
LOCATION="global"
MODEL="gemini-3.8-flash"
# One service account is created per team: <team>-sa@PROJECT_ID.iam.gserviceaccount.com
TEAMS="team-a team-b"

# BigQuery dataset that receives the inference request metadata log (one row per request).
DATASET="gemini_usage"
BQ_LOCATION="US"
SINK_NAME="gemini-usage-sink"
# Table the log sink creates. Keep the default unless you change the sink.
USAGE_TABLE="aiplatform_googleapis_com_inference_request"

# Optional: also log full prompts and responses for MODEL into DATASET.PROMPT_TABLE.
# Not needed for cost tracking. Prompts can hold sensitive data, so it is off by default.
PROMPT_LOGGING="false"
PROMPT_TABLE="prompt_response_log"

# The person or group that sends sample requests by impersonating the team accounts.
# Example: user:alice@example.com or group:platform-team@example.com
CALLER_MEMBER=""

# Optional: your Cloud Billing detailed export table, used by the billing checks.
# Format: billing-project.billing_dataset.gcp_billing_export_resource_v1_XXXXXX_XXXXXX_XXXXXX
BILLING_TABLE=""

# Optional: the gcloud account to run as (leave empty to use the active account).
GCLOUD_ACCOUNT=""
