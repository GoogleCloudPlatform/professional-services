# GCP Project ID to deploy the resources to
project_id = "your-gcp-project-id"

# GCP Region for resource deployment (e.g. us-central1)
region = "us-central1"

# Cloud Run service name (also prefixes Artifact Registry and IAM resources)
service_name = "asop-studio"

# ------------------------------------------------------------------------------
# Optional: Identity-Aware Proxy (IAP) + Global External HTTPS Load Balancer
# Leave commented out for a fast, direct Cloud Run deployment.
# Uncomment and configure below for enterprise IAP-protected deployment
# (see docs/06_gcp_deployment_and_iap.md for step-by-step OAuth setup).
# ------------------------------------------------------------------------------
# enable_iap        = true
# iap_client_id     = "your-oauth-client-id.apps.googleusercontent.com"
# iap_client_secret = "your-oauth-client-secret"
# allowed_identities = [
#   "user:your-email@example.com",
#   "group:team-group@example.com"
# ]
# domain_name = "asop.example.com"
